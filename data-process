import pandas as pd
from sklearn import preprocessing
from sklearn.decomposition import KernelPCA
from sklearn.model_selection import train_test_split

from WCHS import WCHS


def evaluate_dataset(file_path):
    data = pd.read_excel(file_path, sheet_name=0, header=None)
    dataset_params = {'k': 5, 'lamba1': 0.5, 'lamba2': 3}  # set dataset_params according to the dataset

    # 1. split
    x = data.iloc[:, 1:]
    y = data.iloc[:, 0]

    # Ensure binary labels are 0 and 1
    unique_labels = y.unique()
    if len(unique_labels) != 2:
        raise ValueError("Only binary classification is supported.")
    pos_count = (y == 1).sum()
    neg_count = (y == 0).sum()
    # If positive class is the majority, swap so that adaptive Sampling
    if pos_count > neg_count:
        y = y.replace({0: 1, 1: 0})

    x_train, x_test, y_train, y_test = \
        train_test_split(x, y, test_size=0.2, stratify=y, random_state=0)  # random_state = random_state

    # 2. Normalize  # [0,1]
    standard_train_x = preprocessing.MinMaxScaler()
    scaler_standard = standard_train_x.fit(x_train)
    x_train = scaler_standard.transform(x_train)
    x_test = scaler_standard.transform(x_test)

    # 3. KPCA
    KPCA = KernelPCA(n_components=10, kernel='rbf')
    kpca_standard = KPCA.fit(x_train)
    x_train = kpca_standard.transform(x_train)
    x_test = kpca_standard.transform(x_test)
    x_train = pd.DataFrame(x_train)
    x_test = pd.DataFrame(x_test)

    # 4.
    x_train, y_train = WCHS(x_train, y_train, dataset_params)

    return x_train, y_train, x_test, y_test



